# Copy to .env.production, supply private credentials, then run make prod.
# This file is separate from .env (development). Do not commit .env.production.
COMPOSE_PROJECT_NAME=personal-platform-production
BIND_IP=127.0.0.1
FRONTEND_PORT=5173
POSTGRES_DB=personal_platform
POSTGRES_USER=personal_platform
# Required. Single-quote values containing $, # or whitespace in this env file.
POSTGRES_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
LOG_LEVEL=info

# Shared by all Apps/users; integer 1–100. Keep PostgreSQL connection headroom
# for migrations, administration and maintenance above this pool size.
DATABASE_POOL_MAX=4
PG_SHARED_BUFFERS=64MB
PG_WORK_MEM=2MB
PG_MAINTENANCE_WORK_MEM=32MB
PG_MAX_CONNECTIONS=30

# Ten failed probes at 30s intervals take roughly five minutes to mark unhealthy.
HEALTHCHECK_INTERVAL=30s
# Ceilings are not reservations or minimum hardware requirements.
DATABASE_MEMORY_LIMIT=1G
BACKEND_MEMORY_LIMIT=512M
FRONTEND_MEMORY_LIMIT=256M
DATABASE_CPU_LIMIT=1.0
BACKEND_CPU_LIMIT=1.0
FRONTEND_CPU_LIMIT=0.5

# Production requires an HTTPS reverse proxy for browser login by default.
SESSION_COOKIE_SECURE=true
# Backend trusts the internal Nginx proxy. Nginx replaces untrusted XFF.
TRUST_PROXY=uniquelocal

# Private NAS / HTTP origins require an explicit exact-origin allowlist.
DATA_BACKUP_ALLOWED_ORIGINS=
# Optional base64 32-byte key; empty uses persistent storage/.core/backup.key.
DATA_BACKUP_ENCRYPTION_KEY=

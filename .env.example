# Copy to .env for local Docker Compose development.
COMPOSE_PROJECT_NAME=personal-platform
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
POSTGRES_DB=personal_platform
POSTGRES_USER=personal_platform
POSTGRES_PASSWORD=change-me-for-local-development
LOG_LEVEL=INFO

# Runtime environment of the backend platform (AUTH-H1-02). Env overrides the
# config/platform.yaml `platform.environment` value (env > yaml).
# - development (default): the pp_session cookie is sent WITHOUT Secure so
#   plain-HTTP local flows work.
# - production: the pp_session cookie is set with Secure — use behind HTTPS.
# PLATFORM_ENVIRONMENT=production

# Explicit override for the session cookie Secure flag (AUTH-H1-02).
# Precedence: this variable > PLATFORM_ENVIRONMENT > platform.yaml.
# Set to false ONLY for a known HTTP-only production deployment.
# SESSION_COOKIE_SECURE=true

# Trusted reverse proxy for client IP resolution (AUTH-H1-03). Unset = do NOT
# trust X-Forwarded-For (safe default; the login limiter keys on the direct
# peer address). Values are passed to Fastify/proxy-addr:
#   loopback | uniquelocal | <ip>,<cidr>,…  → only these peers are trusted
#   true                                     → trust every peer (ONLY when the
#                                              backend is reachable solely via
#                                              the proxy — never with its port
#                                              exposed)
# Intended topology: Browser → (Nginx/TLS) → frontend/backend; e.g.
# TRUST_PROXY=uniquelocal covers the Docker Compose network (172.16.0.0/12).
# TRUST_PROXY=loopback

# Integration tests (optional; defaults to a local test database on 5439).
# TEST_DATABASE_URL=postgresql://personal_platform:change-me-for-local-development@127.0.0.1:5432/personal_platform_test

# Authentication bootstrap (optional): activate the first admin account.
# - With both set, the backend activates the seeded placeholder admin at startup.
# - Idempotent: an already-activated account is never rewritten (passwords are
#   NEVER reset); if the requested username differs and the placeholder is
#   still pending, it is renamed in place (stable id, backfilled data follows).
# - Bootstrap establishes the FIRST admin only (AUTH-H1-05): once an activated
#   admin exists, changing these values does NOT create a second admin.
# - Interactive alternative: `npm run bootstrap:admin -- --username <name>`
#   (hidden password prompt; also reads BOOTSTRAP_ADMIN_PASSWORD).
# - Keep real secrets out of git — set values in .env only, never commit them.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=

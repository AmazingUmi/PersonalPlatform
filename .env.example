# Copy to .env for local Docker Compose development.
COMPOSE_PROJECT_NAME=personal-platform
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
POSTGRES_DB=personal_platform
POSTGRES_USER=personal_platform
POSTGRES_PASSWORD=change-me-for-local-development
LOG_LEVEL=INFO

# Integration tests (optional; defaults to a local test database on 5439).
# TEST_DATABASE_URL=postgresql://personal_platform:change-me-for-local-development@127.0.0.1:5432/personal_platform_test

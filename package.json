{
  "name": "personal-platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run generate:apps && npm run build --workspaces --if-present",
    "check": "npm run generate:apps:check && npm run check --workspaces --if-present",
    "generate:apps": "tsx scripts/generate-apps-registry.ts",
    "generate:apps:check": "tsx scripts/generate-apps-registry.ts --check",
    "migration:up": "tsx backend/src/cli/migrate.ts up",
    "migration:status": "tsx backend/src/cli/migrate.ts status",
    "migration:create": "tsx backend/src/cli/migrate.ts create",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
